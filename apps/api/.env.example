# ---- Paper Analyzer API (apps/api): server settings and secrets. Never share or commit. ----

# API server
API_PORT=4100
WEB_ORIGIN=http://localhost:3000

# Where PDFs, page images and cropped images are stored (local disk in Phase 0)
STORAGE_ROOT=D:/paper-analyzer-storage

# Admin "Upload" password and token signing secret (change both!)
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-string

# AI: "mock" = sample data, no key needed. "gemini" or "openai" = real extraction.
AI_PROVIDER=mock
OPENAI_API_KEY=
# A current vision-capable model with Structured Outputs. Check platform.openai.com/docs/models
OPENAI_MODEL=gpt-5-mini
# Pages sent to the AI in parallel
AI_PAGE_CONCURRENCY=3

# Google Gemini (AI_PROVIDER=gemini). Key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Requests per minute your key allows (free key: 5). 0 = no limit
GEMINI_RPM=5
# Backup models (comma-separated), used when the main model is overloaded or out of daily quota
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest

# Database (MySQL 8+ / MariaDB). Fill in, then: npm --prefix apps/api run db:migrate && npm --prefix apps/api run db:seed
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=paper_analyzer
