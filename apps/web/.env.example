# ---- Paper Analyzer website (apps/web) ----
# Only VITE_* variables are read here, and they are visible in the browser: never put secrets in this file.

# Frontend (Vite) -> API base URL
# Empty = the website reaches the API through its own address (port 3000 proxies /api and /files to the API).
# Only set this if the API is hosted on a different address.
VITE_API_URL=
